# FC Market Intelligence — environment variables
# Copy to .env.local for local development. Never commit real values.

# --- Required: Supabase (Project Settings → API) -----------------------------
# Public by design: every query is restricted by row level security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_…) or the legacy anon JWT key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Legacy name, also accepted if the variable above is unset:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Recommended in production ----------------------------------------------
# Absolute origin used in sign-up and password-reset email links.
# Must also be listed in Supabase → Authentication → URL Configuration.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Optional: AI analyst (server-side only, never exposed to the browser) ---
# Without a key, briefings fall back to an automated rule-based summary and
# questions are disabled.
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5.
ANTHROPIC_MODEL=

# Not used: the app needs NO Supabase service-role key. Do not add one.
